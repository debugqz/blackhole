root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2

[*.json]
indent_size = 2

[Cargo.toml]
indent_size = 4

[Makefile]
indent_style = tab

[*.sh]
indent_size = 4

[*.{ts,tsx,js,jsx,css,html}]
indent_size = 2
